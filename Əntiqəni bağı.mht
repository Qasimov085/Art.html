:root { --background: 43 45% 96%; --foreground: 151 28% 16%; --border: 39 22% 83%; --card: 43 43% 98%; --card-foreground: 151 28% 16%; --input: 39 22% 83%; --popover: 43 43% 98%; --popover-foreground: 151 28% 16%; --primary: 151 39% 27%; --primary-foreground: 43 45% 96%; --secondary: 35 64% 88%; --secondary-foreground: 151 28% 16%; --muted: 43 29% 91%; --muted-foreground: 151 13% 43%; --accent: 8 55% 58%; --accent-foreground: 43 45% 96%; --destructive: 4 66% 48%; --destructive-foreground: 43 45% 96%; --ring: 151 39% 27%; --app-font-sans: 'DM Sans', sans-serif; --app-font-serif: 'Playfair Display', Georgia, serif; --app-font-mono: 'DM Sans', monospace; --radius: 1rem; --spacing: 0.25rem; --button-outline: rgba(30, 55, 42, .12); --badge-outline: rgba(30, 55, 42, .08); --elevate-1: rgba(30, 55, 42, .03); --elevate-2: rgba(30, 55, 42, .07); --shadow: 0 14px 40px rgba(40, 60, 45, .08); }

.dark { --background: 151 22% 12%; --foreground: 43 35% 91%; --border: 151 14% 28%; --card: 151 20% 16%; --card-foreground: 43 35% 91%; --input: 151 14% 28%; --popover: 151 20% 16%; --popover-foreground: 43 35% 91%; --primary: 35 64% 68%; --primary-foreground: 151 22% 12%; --secondary: 151 18% 22%; --secondary-foreground: 43 35% 91%; --muted: 151 18% 22%; --muted-foreground: 43 18% 66%; --accent: 8 55% 63%; --accent-foreground: 151 22% 12%; --destructive: 4 66% 55%; --destructive-foreground: 43 45% 96%; --ring: 35 64% 68%; }

@layer base {
  * { border-color: hsl(var(--border)); }
  html { scroll-behavior: smooth; }
  body { background-color: hsl(var(--background)); color: hsl(var(--foreground)); -webkit-font-smoothing: antialiased; font-family: var(--app-font-sans); }
  :focus-visible { outline: rgb(49, 93, 67) solid 2px; outline-offset: 3px; }
}

:root { color-scheme: light; }

::selection { background: rgb(217, 161, 131); color: rgb(24, 61, 45); }

.serif { font-family: var(--app-font-serif); }

.eyebrow { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; }

.site-shell { overflow: clip; }

.hero-photo { background-image: linear-gradient(90deg, rgba(19, 45, 31, 0.66) 0%, rgba(22, 44, 31, 0.22) 54%, rgba(20, 40, 27, 0.03) 100%), url("/images/tulip-hero.jpg"); background-size: cover; background-position: center 54%; }

.reveal { animation: 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running rise-in; }

.reveal-delay { animation-delay: 0.16s; }

.reveal-delay-2 { animation-delay: 0.3s; }

@keyframes rise-in { 
  0% { opacity: 0; transform: translateY(22px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.image-hover img { transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }

.image-hover:hover img { transform: scale(1.045); }

.nav-link { position: relative; }

.nav-link::after { content: ""; position: absolute; bottom: -6px; left: 0px; width: 100%; height: 1px; background: currentcolor; transform: scaleX(0); transform-origin: right center; transition: transform 0.25s; }

.nav-link:hover::after { transform: scaleX(1); transform-origin: left center; }

.grain::after { content: ""; pointer-events: none; position: fixed; inset: 0px; z-index: 40; opacity: 0.035; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E"); }

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

:root { --paper: #f6f3e8; --paper-deep: #e9ecdd; --ink: #203b2c; --leaf: #315d43; --muted-ink: #657567; --clay: #a15d43; --peach: #edc49e; --line: #cbd0c1; }

body { background: var(--paper); color: var(--ink); }

.site-shell { min-height: 100dvh; overflow: clip; }

.site-header { position: absolute; z-index: 30; inset: 0px 0px auto; color: rgb(251, 248, 239); }

.header-inner { max-width: 1440px; margin: auto; padding: 21px clamp(20px, 5vw, 72px); display: flex; justify-content: space-between; align-items: center; gap: 24px; }

.brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; flex-shrink: 0; }

.brand-mark { width: 42px; height: 42px; border: 1px solid; border-radius: 50%; display: grid; place-items: center; }

.brand strong { display: block; font: 500 1.18rem/1.1 var(--app-font-serif); letter-spacing: 0.01em; }

.brand small { display: block; margin-top: 6px; font-size: 0.55rem; letter-spacing: 0.21em; opacity: 0.74; }

.desktop-nav { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 38px); }

.nav-item { position: relative; color: rgba(251, 248, 239, 0.84); text-decoration: none; font-size: 0.78rem; transition: color 0.2s; white-space: nowrap; }

.nav-item::after { content: ""; position: absolute; height: 1px; background: var(--peach); inset: auto 0px -7px; transform: scaleX(0); transform-origin: left center; transition: transform 0.24s; }

.nav-item:hover, .nav-item.active { color: rgb(255, 247, 232); }

.nav-item.active::after, .nav-item:hover::after { transform: scaleX(1); }

.menu-toggle { display: none; background: transparent; border: 1px solid rgba(255, 255, 255, 0.65); color: inherit; border-radius: 50%; width: 44px; height: 44px; place-items: center; }

.mobile-nav { display: none; }

.hero-photo { background-image: url("/images/tulip-hero.jpg"); background-size: cover; background-position: center 52%; }

.hero { min-height: max(720px, 100svh); display: flex; position: relative; align-items: flex-end; color: rgb(251, 248, 239); }

.hero-shade { position: absolute; inset: 0px; background: linear-gradient(90deg, rgba(19, 45, 31, 0.67), rgba(22, 44, 31, 0.22) 59%, rgba(20, 40, 27, 0.02)), linear-gradient(0deg, rgba(15, 38, 26, 0.43), transparent 55%); }

.hero-content { position: relative; z-index: 1; max-width: 760px; padding: 172px 24px 94px clamp(24px, 9vw, 132px); animation: 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running rise-in; }

.eyebrow { color: var(--clay); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.19em; font-weight: 700; }

.hero-eyebrow { display: flex; align-items: center; gap: 12px; color: rgb(242, 205, 168); margin-bottom: 21px; }

.hero-eyebrow span { width: 35px; height: 1px; background: currentcolor; }

.hero h1, .page-intro h1, .not-found h1 { font: 500 clamp(3.7rem, 9vw, 8.4rem)/.93 var(--app-font-serif); letter-spacing: -0.057em; margin: 0px; }

.hero h1 em, .story h2 em, .section-heading h2 em, .visit-banner h2 em, .page-intro h1 em, .month-title h2 em, .request-heading h2 em, .form-card-heading h2 em, .not-found h1 em { color: rgb(239, 197, 161); font-weight: 500; }

.hero-content > p { margin: 24px 0px 0px; max-width: 470px; font-size: 1rem; line-height: 1.85; color: rgba(255, 255, 255, 0.86); }

.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 17px; margin-top: 30px; }

.button { border: 0px; padding: 14px 20px; display: inline-flex; justify-content: center; align-items: center; gap: 12px; text-decoration: none; border-radius: 999px; font-size: 0.83rem; font-weight: 700; cursor: pointer; transition: transform 0.2s, background 0.2s, color 0.2s; }

.button:hover { transform: translateY(-2px); }

.button:disabled { opacity: 0.58; cursor: wait; transform: none; }

.button-peach { background: var(--peach); color: rgb(38, 63, 48); }

.button-peach:hover { background: rgb(247, 216, 186); }

.button-green { background: var(--leaf); color: rgb(251, 248, 239); }

.button-green:hover { background: rgb(35, 72, 50); }

.text-link { display: inline-flex; align-items: center; gap: 10px; padding: 0px 0px 8px; border-width: 0px 0px 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(174, 182, 167); border-image: none; background: transparent; color: var(--leaf); text-decoration: none; font-size: 0.83rem; font-weight: 700; cursor: pointer; transition: color 0.2s; }

.text-link:hover { color: var(--clay); }

.text-link.light { color: rgb(255, 255, 255); border-color: rgba(255, 255, 255, 0.38) rgba(255, 255, 255, 0.38) transparent; }

.hero-caption { position: absolute; bottom: 56px; right: clamp(24px, 7vw, 98px); padding-left: 17px; border-left: 1px solid rgba(255, 255, 255, 0.55); font-size: 0.72rem; line-height: 1.7; color: rgba(255, 255, 255, 0.82); }

.hero-index { position: absolute; right: 27px; top: 50%; writing-mode: vertical-rl; color: rgba(255, 255, 255, 0.7); font-size: 0.58rem; letter-spacing: 0.18em; }

.section-pad { padding: clamp(76px, 10vw, 145px) clamp(22px, 7vw, 100px); }

.story { max-width: 1440px; margin: auto; display: grid; grid-template-columns: 0.9fr 1fr; gap: clamp(55px, 10vw, 145px); align-items: center; }

.story-image { height: clamp(360px, 49vw, 565px); position: relative; overflow: visible; }

.story-image img { width: 100%; height: 100%; object-fit: cover; border-radius: 48% 48% 0px 0px; }

.image-note { position: absolute; right: -28px; bottom: -17px; background: rgb(233, 236, 221); color: var(--leaf); padding: 17px 22px; font-size: 0.7rem; }

.story-copy { max-width: 570px; }

.story h2, .section-heading h2, .visit-banner h2, .request-heading h2, .form-card-heading h2 { margin: 18px 0px 0px; color: var(--ink); font: 500 clamp(2.65rem, 5.4vw, 4.7rem)/1.04 var(--app-font-serif); letter-spacing: -0.045em; }

.story h2 em, .section-heading h2 em { color: var(--clay); }

.story-copy p { max-width: 520px; color: var(--muted-ink); font-size: 0.94rem; line-height: 1.9; margin: 21px 0px 0px; }

.story-copy .text-link { margin-top: 29px; }

.values-band { background: rgb(233, 236, 221); display: grid; grid-template-columns: repeat(3, 1fr); padding: 37px clamp(22px, 9vw, 130px); }

.values-band > div { padding: 0px 35px; border-right: 1px solid rgb(203, 208, 193); }

.values-band > div:first-child { padding-left: 0px; }

.values-band > div:last-child { border: 0px; }

.values-band span { display: block; color: var(--clay); font: 500 2.25rem var(--app-font-serif); }

.values-band > div:nth-child(2) span { color: var(--leaf); }

.values-band small { display: block; margin-top: 6px; color: var(--muted-ink); font-size: 0.75rem; }

.home-pathways { max-width: 1440px; margin: auto; }

.section-heading { display: flex; justify-content: space-between; gap: 28px; align-items: end; margin-bottom: 54px; }

.section-heading h2 { font-size: clamp(2.7rem, 5vw, 4.4rem); }

.section-heading h2 em { color: var(--clay); }

.section-heading > p { max-width: 350px; color: var(--muted-ink); font-size: 0.88rem; line-height: 1.75; padding-bottom: 6px; }

.pathway-grid { display: grid; grid-template-columns: 1.08fr 0.94fr 0.98fr; gap: 14px; }

.pathway { min-height: 300px; padding: 27px 30px; display: flex; flex-direction: column; color: var(--ink); text-decoration: none; transition: transform 0.25s; }

.pathway:hover { transform: translateY(-5px); }

.pathway-guide { background: rgb(233, 236, 221); }

.pathway-calendar { background: rgb(239, 229, 212); margin-top: 34px; }

.pathway-products { background: rgb(231, 233, 223); margin-top: 68px; }

.pathway-number { align-self: flex-end; font-size: 0.59rem; letter-spacing: 0.15em; color: var(--muted-ink); }

.pathway > svg { color: var(--clay); margin-top: 24px; }

.pathway h3 { margin: 21px 0px 0px; font: 500 1.8rem var(--app-font-serif); }

.pathway p { max-width: 290px; margin: 9px 0px 20px; color: var(--muted-ink); font-size: 0.83rem; line-height: 1.7; }

.pathway-go { margin-top: auto; display: flex; gap: 9px; align-items: center; color: var(--leaf); font-size: 0.75rem; font-weight: 700; }

.visit-banner { display: grid; grid-template-columns: 1.08fr 1fr; background: rgb(38, 74, 54); color: var(--paper); }

.visit-banner-image { height: 590px; overflow: hidden; }

.visit-banner-image img { width: 100%; height: 100%; object-fit: cover; }

.visit-banner-copy { align-self: center; max-width: 620px; padding: 65px clamp(32px, 8vw, 115px); }

.visit-banner-copy .eyebrow { color: var(--peach); }

.visit-banner h2 { color: var(--paper); font-size: clamp(3rem, 5.4vw, 5rem); }

.visit-banner-copy > p { margin: 20px 0px 27px; font-size: 0.9rem; line-height: 1.8; color: rgba(255, 255, 255, 0.76); }

.site-footer { background: rgb(30, 62, 45); color: var(--paper); padding: 30px clamp(22px, 7vw, 100px); }

.footer-inner { max-width: 1440px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 25px; }

.footer-brand .brand-mark { width: 38px; height: 38px; }

.footer-brand strong { font-size: 1rem; }

.footer-inner > p, .copyright { color: rgba(255, 255, 255, 0.59); font-size: 0.7rem; }

.page-intro { min-height: 395px; position: relative; display: flex; align-items: flex-end; gap: 30px; overflow: hidden; padding: 142px clamp(24px, 9vw, 130px) 62px; background: rgb(38, 74, 54); color: var(--paper); }

.intro-number { align-self: flex-end; padding-bottom: 13px; color: rgb(237, 196, 158); font: 500 1rem var(--app-font-serif); }

.page-intro .eyebrow { color: var(--peach); }

.page-intro h1 { margin-top: 15px; font-size: clamp(3.4rem, 7vw, 6.6rem); }

.page-intro h1 em { color: var(--peach); }

.page-intro p { max-width: 570px; margin: 17px 0px 0px; color: rgba(255, 255, 255, 0.76); font-size: 0.91rem; line-height: 1.8; }

.intro-flower { position: absolute; width: 360px; height: 360px; right: 6%; top: 66px; color: rgba(237, 196, 158, 0.11); }

.content-wrap { max-width: 1300px; margin: 0px auto; padding: 64px clamp(22px, 6vw, 82px) 105px; }

.toolbar { display: flex; justify-content: space-between; align-items: center; gap: 22px; flex-wrap: wrap; }

.search-field { width: min(330px, 100%); display: flex; align-items: center; gap: 10px; padding: 12px 0px; border-bottom: 1px solid rgb(173, 183, 168); color: var(--leaf); }

.search-field input { width: 100%; border: 0px; outline: 0px; background: transparent; color: var(--ink); font-size: 0.84rem; }

.search-field input::placeholder { color: rgb(139, 150, 137); }

.filter-list { display: flex; flex-wrap: wrap; gap: 7px; }

.filter-chip { border: 1px solid rgb(203, 208, 193); border-radius: 100px; padding: 9px 14px; color: var(--muted-ink); background: transparent; font-size: 0.7rem; cursor: pointer; transition: 0.2s; }

.filter-chip:hover, .filter-chip.selected { background: var(--leaf); border-color: var(--leaf); color: var(--paper); }

.result-count { margin: 34px 0px 17px; color: var(--ink); font: 500 1.2rem var(--app-font-serif); }

.result-count span { padding: 0px 7px; color: var(--clay); }

.result-count { font-size: 0.83rem; }

.guide-grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 38px 24px; }

.guide-card { background: rgb(240, 238, 226); }

.guide-image { position: relative; height: 255px; overflow: hidden; }

.guide-image img, .product-photo img { width: 100%; height: 100%; object-fit: cover; }

.guide-image > span { position: absolute; top: 15px; left: 15px; padding: 7px 11px; background: var(--paper); color: var(--leaf); font-size: 0.65rem; }

.guide-copy { padding: 20px 24px 26px; }

.guide-meta { display: flex; justify-content: space-between; color: var(--clay); font-size: 0.58rem; letter-spacing: 0.12em; }

.guide-meta span:last-child { color: var(--muted-ink); letter-spacing: 0px; }

.guide-copy h2 { margin: 15px 0px 8px; font: 500 1.65rem/1.2 var(--app-font-serif); }

.guide-copy p { margin: 0px; color: var(--muted-ink); font-size: 0.81rem; line-height: 1.8; }

.guides-footnote, .calendar-note { display: flex; align-items: center; gap: 14px; margin-top: 48px; padding: 21px 0px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--leaf); }

.guides-footnote p, .calendar-note p { margin: 0px; color: var(--muted-ink); font-size: 0.78rem; line-height: 1.6; }

.empty-state { margin: 30px 0px; padding: 55px 20px; background: rgb(233, 236, 221); text-align: center; color: var(--leaf); }

.empty-state h2 { font: 500 1.5rem var(--app-font-serif); }

.empty-state p { color: var(--muted-ink); font-size: 0.85rem; }

.calendar-wrap { max-width: 1160px; }

.calendar-top { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 25px; }

.calendar-top h2 { font: 500 2rem var(--app-font-serif); margin: 8px 0px 0px; }

.calendar-top > p { max-width: 390px; color: var(--muted-ink); font-size: 0.78rem; line-height: 1.7; margin: 0px; }

.month-selector { display: grid; grid-template-columns: repeat(12, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

.month-selector button { border-top: 0px; border-bottom: 0px; border-left: 0px; border-image: none; border-right: 1px solid var(--line); padding: 14px 3px; background: transparent; color: var(--muted-ink); font: 500 .75rem var(--app-font-serif); cursor: pointer; transition: background 0.2s, color 0.2s; }

.month-selector button:last-child { border-right: 0px; }

.month-selector button:hover, .month-selector button.month-active { background: var(--leaf); color: var(--paper); }

.month-feature { margin-top: 26px; display: grid; grid-template-columns: 142px 1fr 250px; background: rgb(233, 236, 221); min-height: 375px; }

.month-stamp { background: var(--clay); display: flex; flex-direction: column; justify-content: center; align-items: center; color: var(--paper); }

.month-stamp span:first-child { font-size: 0.57rem; letter-spacing: 0.2em; }

.month-stamp strong { font: 500 4rem/.95 var(--app-font-serif); }

.month-stamp span:last-child { margin-top: 12px; font-size: 0.64rem; text-align: center; }

.month-detail { padding: 35px clamp(24px, 4vw, 50px); }

.month-title h2 { margin: 8px 0px 21px; font: 500 2.8rem var(--app-font-serif); }

.month-title h2 em { color: var(--clay); }

.month-detail ol { padding: 0px; margin: 0px; list-style: none; }

.month-detail li { display: flex; gap: 14px; padding: 13px 0px; border-top: 1px solid rgb(203, 208, 193); }

.month-detail li > span { color: var(--clay); font: 500 .76rem var(--app-font-serif); }

.month-detail li p { margin: 0px; color: var(--muted-ink); font-size: 0.77rem; line-height: 1.7; }

.month-image { min-height: 100%; }

.month-image img { width: 100%; height: 100%; object-fit: cover; }

.calendar-note { margin-top: 24px; border: 0px; background: rgb(239, 229, 212); padding: 18px 21px; }

.calendar-note > svg { flex-shrink: 0; color: var(--clay); }

.calendar-note strong { color: var(--ink); }

.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: start; }

.product-card:nth-child(2) { margin-top: 43px; }

.product-card:nth-child(3) { margin-top: 86px; }

.product-photo { height: 265px; position: relative; overflow: hidden; }

.product-num { position: absolute; left: 14px; top: 14px; width: 36px; height: 36px; background: var(--paper); display: grid; place-items: center; color: var(--clay); font: 500 .95rem var(--app-font-serif); }

.product-body { padding: 21px 22px 25px; background: rgb(233, 236, 221); }

.product-body h2 { margin: 10px 0px 8px; font: 500 1.65rem var(--app-font-serif); }

.product-body p { min-height: 79px; color: var(--muted-ink); font-size: 0.78rem; line-height: 1.75; }

.product-body .text-link { margin-top: 6px; font-size: 0.72rem; }

.request-panel { display: grid; grid-template-columns: 0.78fr 1.22fr; gap: clamp(40px, 8vw, 110px); margin-top: 115px; padding: clamp(28px, 5vw, 64px); background: rgb(238, 232, 216); }

.request-heading h2, .form-card-heading h2 { font-size: clamp(2.5rem, 4vw, 3.8rem); }

.request-heading h2 em, .form-card-heading h2 em { color: var(--clay); }

.request-heading > p, .form-card-heading > p { color: var(--muted-ink); font-size: 0.81rem; line-height: 1.8; margin-top: 17px; }

.pending-label { margin-top: 26px; display: flex; gap: 9px; align-items: center; color: var(--muted-ink); font-size: 0.66rem; line-height: 1.5; }

.pending-label span { width: 7px; height: 7px; border-radius: 50%; background: rgb(193, 122, 72); }

.request-form { display: flex; flex-direction: column; gap: 17px; }

.request-form label { display: flex; flex-direction: column; gap: 8px; color: var(--ink); font-size: 0.73rem; font-weight: 700; }

.request-form input, .request-form select, .request-form textarea { width: 100%; min-width: 0px; border: 1px solid rgb(201, 205, 191); border-radius: 2px; padding: 12px 13px; color: var(--ink); outline: 0px; background: rgba(250, 248, 239, 0.72); font: 400 .79rem var(--app-font-sans); }

.request-form input:focus, .request-form select:focus, .request-form textarea:focus { border-color: var(--leaf); box-shadow: rgba(49, 93, 67, 0.1) 0px 0px 0px 2px; }

.request-form input::placeholder, .request-form textarea::placeholder { color: rgb(146, 154, 141); }

.request-form textarea { resize: vertical; }

.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }

.optional { color: rgb(146, 154, 141); font-weight: 400; }

.request-form > .button { align-self: flex-start; margin-top: 2px; }

.request-notice { display: flex; gap: 13px; background: rgb(220, 230, 216); padding: 15px; color: var(--leaf); }

.notice-check { width: 27px; height: 27px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: var(--leaf); color: white; }

.request-notice strong { display: block; font: 600 .92rem var(--app-font-serif); }

.request-notice p { margin: 5px 0px 7px; color: rgb(79, 103, 84); font-size: 0.73rem; line-height: 1.6; }

.request-notice small { font-size: 0.56rem; letter-spacing: 0.13em; }

.form-error { background: rgb(242, 222, 212); color: rgb(140, 65, 51); padding: 12px 14px; font-size: 0.75rem; line-height: 1.5; }

.visit-layout { display: grid; grid-template-columns: 0.95fr 1fr; gap: clamp(45px, 8vw, 110px); align-items: start; }

.visit-image { height: 660px; position: relative; overflow: hidden; }

.visit-image img { width: 100%; height: 100%; object-fit: cover; }

.visit-image-caption { position: absolute; bottom: 0px; inset-inline: 0px; display: flex; align-items: center; gap: 10px; padding: 18px 21px; background: linear-gradient(transparent, rgba(20, 45, 31, 0.78)); color: white; font-size: 0.75rem; }

.visit-form-card { padding: 32px clamp(24px, 4vw, 45px); background: rgb(233, 236, 221); }

.form-card-heading { margin-bottom: 29px; }

.form-card-heading h2 { margin-top: 13px; }

.form-card-heading > p { max-width: 430px; }

.visit-form-card .request-form { gap: 15px; }

.form-privacy { margin: -4px 0px 0px; color: var(--muted-ink); font-size: 0.66rem; line-height: 1.6; }

.not-found { min-height: 100dvh; padding: 170px 24px 100px clamp(24px, 14vw, 200px); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; background: rgb(38, 74, 54); color: var(--paper); }

.not-found .eyebrow { color: var(--peach); }

.not-found h1 { margin-top: 18px; font-size: clamp(4rem, 9vw, 7rem); }

.not-found h1 em { color: var(--peach); }

.not-found p { color: rgba(255, 255, 255, 0.72); font-size: 0.9rem; margin: 22px 0px 28px; }

@media (max-width: 850px) {
  .desktop-nav { gap: 14px; }
  .nav-item { font-size: 0.7rem; }
  .header-inner { padding-inline: 24px; }
  .month-feature { grid-template-columns: 110px 1fr; }
  .month-image { display: none; }
  .visit-layout { gap: 35px; }
  .visit-image { height: 570px; }
  .request-panel { gap: 35px; }
}

@media (max-width: 700px) {
  .header-inner { padding: 15px 19px; }
  .brand-mark { width: 38px; height: 38px; }
  .brand strong { font-size: 1.05rem; }
  .desktop-nav { display: none; }
  .menu-toggle { display: grid; }
  .mobile-nav { display: flex; flex-direction: column; position: absolute; top: 70px; left: 14px; right: 14px; padding: 10px 19px; background: rgba(24, 61, 45, 0.97); border: 1px solid rgba(255, 255, 255, 0.16); backdrop-filter: blur(12px); }
  .mobile-nav a { min-height: 47px; display: flex; justify-content: space-between; align-items: center; color: var(--paper); text-decoration: none; border-bottom: 1px solid rgba(255, 255, 255, 0.12); font-size: 0.85rem; }
  .mobile-nav a:last-child { border-bottom: 0px; }
  .mobile-nav a.active { color: var(--peach); }
  .hero { min-height: 100svh; }
  .hero-content { padding: 150px 24px 80px; }
  .hero h1 { font-size: clamp(3.5rem, 14vw, 6rem); }
  .hero-content > p { font-size: 0.9rem; line-height: 1.75; }
  .hero-caption, .hero-index { display: none; }
  .story { grid-template-columns: 1fr; gap: 56px; }
  .story-image { height: 400px; margin: 0px 15px 12px 0px; }
  .story-copy { order: -1; }
  .values-band { grid-template-columns: 1fr; padding-block: 25px; }
  .values-band > div, .values-band > div:first-child { padding: 15px 0px; border-right: 0px; border-bottom: 1px solid rgb(203, 208, 193); }
  .values-band > div:last-child { border: 0px; }
  .values-band span { font-size: 1.9rem; }
  .section-heading { align-items: flex-start; flex-direction: column; margin-bottom: 30px; }
  .section-heading > p { margin: 0px; }
  .pathway-grid { grid-template-columns: 1fr; gap: 11px; }
  .pathway, .pathway-calendar, .pathway-products { min-height: 245px; margin: 0px; }
  .visit-banner { grid-template-columns: 1fr; }
  .visit-banner-image { height: 300px; }
  .visit-banner-copy { padding: 54px 24px 62px; }
  .footer-inner { align-items: flex-start; flex-direction: column; gap: 13px; }
  .footer-inner > p { margin: 0px; }
  .page-intro { min-height: 390px; padding: 140px 24px 46px; gap: 13px; }
  .intro-number { font-size: 0.8rem; }
  .page-intro h1 { font-size: clamp(3rem, 11vw, 4.6rem); }
  .page-intro p { font-size: 0.82rem; max-width: 500px; }
  .intro-flower { width: 230px; height: 230px; top: 105px; right: -55px; }
  .content-wrap { padding: 42px 20px 70px; }
  .toolbar { align-items: stretch; }
  .search-field { width: 100%; }
  .filter-list { gap: 6px; }
  .filter-chip { padding: 8px 11px; font-size: 0.65rem; }
  .guide-grid { grid-template-columns: 1fr; gap: 22px; }
  .guide-image { height: 230px; }
  .guide-copy { padding: 18px 19px 22px; }
  .calendar-top { align-items: flex-start; flex-direction: column; }
  .month-selector { grid-template-columns: repeat(6, 1fr); }
  .month-selector button { border-bottom: 1px solid var(--line); padding: 12px 3px; }
  .month-selector button:nth-child(6n) { border-right: 0px; }
  .month-selector button:nth-last-child(-n+6) { border-bottom: 0px; }
  .month-feature { grid-template-columns: 75px 1fr; }
  .month-stamp strong { font-size: 2.8rem; }
  .month-stamp span:last-child { max-width: 65px; font-size: 0.56rem; }
  .month-detail { padding: 24px 18px; }
  .month-title h2 { font-size: 2.1rem; }
  .month-detail li { gap: 9px; }
  .month-detail li p { font-size: 0.71rem; }
  .product-grid { grid-template-columns: 1fr; gap: 20px; }
  .product-card:nth-child(2), .product-card:nth-child(3) { margin-top: 0px; }
  .product-photo { height: 260px; }
  .product-body p { min-height: 0px; }
  .request-panel { grid-template-columns: 1fr; gap: 28px; margin-top: 72px; padding: 27px 20px; }
  .request-heading h2, .form-card-heading h2 { font-size: 2.8rem; }
  .visit-layout { grid-template-columns: 1fr; gap: 25px; }
  .visit-image { height: 360px; }
  .visit-form-card { padding: 26px 19px; }
  .form-row { grid-template-columns: 1fr; }
  .not-found { padding-left: 25px; }
}

